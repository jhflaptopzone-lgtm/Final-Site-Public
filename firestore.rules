rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Test collection for connectivity checks
    match /test/{docId} {
      allow read, write: if true;
    }

    // 1. Users Collection & Role Management
    match /users/{userId} {
      allow read, write: if true;
    }

    // 2. Products / Laptop Inventory
    match /products/{productId} {
      allow read, write: if true;
    }

    // 3. Orders Collection
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // 4. Customers Collection
    match /customers/{customerId} {
      allow read, write: if true;
    }

    // 5. Inventory Transactions
    match /inventoryTransactions/{transactionId} {
      allow read, write: if true;
    }

    // 6. Expenses
    match /expenses/{expenseId} {
      allow read, write: if true;
    }

    // 7. Activity Logs
    match /activityLogs/{logId} {
      allow read, write: if true;
    }

    // 8. Notifications
    match /notifications/{notifId} {
      allow read, write: if true;
    }

    // 9. Website & Store Settings
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // 10. Software Library Downloads
    match /software/{softwareId} {
      allow read, write: if true;
    }

    // 11. Hardware Testing Tools
    match /testingTools/{toolId} {
      allow read, write: if true;
    }

    // 12. Operating Systems & Drivers
    match /operatingSystems/{osId} {
      allow read, write: if true;
    }

    // 13. Customer Service Requests
    match /serviceRequests/{requestId} {
      allow read, write: if true;
    }

    // 14. Service Operations & Lab Jobs
    match /services/{serviceId} {
      allow read, write: if true;
    }

    // 15. EMI Plans
    match /emiPlans/{planId} {
      allow read, write: if true;
    }

    // 16. Suppliers
    match /suppliers/{supplierId} {
      allow read, write: if true;
    }

    // 17. Reconditioned Laptops
    match /reconditionLaptops/{laptopId} {
      allow read, write: if true;
    }

    // 18. Laptops Catalog
    match /laptops/{laptopId} {
      allow read, write: if true;
    }

    // 19. Atomic Counters for unique sequences
    match /counters/{counterId} {
      allow read, write: if true;
    }
  }
}

